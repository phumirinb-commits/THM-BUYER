{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "cd \"${CLAUDE_PROJECT_DIR:-.}\" && [ -f .thaimart/update.sh ] && (sh .thaimart/update.sh --quiet >/dev/null 2>&1 &); exit 0 # thaimart-ai-update",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
